                    }
                },
                "conteudo": {
                    "type": "string"
                },
                "titulo": {
                    "type": "string"
                }
            }
        },
        "main.DisciplinaNotas": {
            "type": "object",
            "properties": {
                "codigo": {
                    "type": "string"
                },
                "faltas": {
                    "type": "string"
                },
                "nome": {
                    "type": "string"
                },
                "notas": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "resultado": {
                    "type": "string"
                },
                "situacao": {
                    "type": "string"
                }
            }
        },
        "main.HistoricoRequest": {
            "type": "object",
            "required": [
                "viewState"
            ],
            "properties": {
                "viewState": {
                    "type": "string"
                }
            }
        },
        "main.LoginRequest": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "main.MatriculaRequest": {
            "type": "object",
            "required": [
                "viewState"
            ],
            "properties": {
                "viewState": {
                    "type": "string"
                }
            }
        },
        "main.NotasRequest": {
            "type": "object",
            "required": [
                "viewState"
            ],
            "properties": {
                "viewState": {
                    "type": "string"
                }
            }
        },
        "main.Noticia": {
            "type": "object",
            "properties": {
                "conteudo": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "titulo": {
                    "type": "string"
                }
            }
        },
        "main.TurmaAtestado": {
            "type": "object",
            "properties": {
                "codigo": {
                    "type": "string"
                },
                "horario": {
                    "type": "string"
                },
                "local": {
                    "type": "string"
                },
                "nome": {
                    "type": "string"
                },
                "professor": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "tipo": {
                    "type": "string"
                }
            }
        },
        "main.TurmaData": {
            "type": "object",
            "properties": {
                "cronograma": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.CronogramaItem"
                    }
                },
                "faltas": {
                    "type": "integer"
                },
                "horarios": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "info": {
                    "$ref": "#/definitions/main.TurmaInfo"
                },
                "local": {
                    "type": "string"
                },
                "nome": {
                    "type": "string"
                },
                "notas": {
