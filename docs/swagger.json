                },
                "frontEndId": {
                    "type": "string"
                },
                "nome": {
                    "type": "string"
                }
            }
        },
        "main.TurmaPostRequest": {
            "type": "object",
            "required": [
                "turma",
                "viewState"
            ],
            "properties": {
                "turma": {
                    "$ref": "#/definitions/main.TurmaData"
                },
                "viewState": {
                    "type": "string"
                }
            }
        },
        "main.VinculoRequest": {
            "type": "object",
            "required": [
                "viewState"
            ],
            "properties": {
                "viewState": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Use \"Bearer {jsessionid}\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
